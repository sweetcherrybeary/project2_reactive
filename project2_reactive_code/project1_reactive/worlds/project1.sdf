<?xml version="1.0"?>
<!--
  Project 1 world: a 10 ft x 15 ft room with a 5 ft wide hallway wrapped
  around its east and south sides (a backwards "L").

  Units are meters (1 ft = 0.3048 m). The origin (0, 0) is the outside
  south-west corner. +x points east, +y points north.

    y = 6.096 +=====================+======+   north wall (closed hall end)
              |                     |      |
              |        ROOM         |      |
              |    10 ft x 15 ft      HALL    exterior doorway (5 ft wide,
              |      room door ->            5 ft from the north end)
              |          (5 ft)            |
    y = 1.524 +=====================+      |
              |      HALL (short branch)   |
    y = 0     +============================+
            x = 0                x = 3.048  x = 4.572

  Physics, plugins and lighting follow the TurtleBot 4 simulator's sample
  worlds (turtlebot4_gz_bringup/worlds/warehouse.sdf and maze.sdf).
  The <world name> MUST match the launch file's "world" argument, because
  the TurtleBot 4 sensor bridges build their Gazebo topic names from it.
-->
<sdf version="1.8">
  <world name="project1">

    <!-- Physics: 3 ms time step, try to run at real time. -->
    <physics name="3ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo systems the TurtleBot 4 needs: physics, the GUI's move/spawn
         commands, sending the scene to the GUI, and contact sensing (bumper). -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Flat floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls: 0.1 m thick, 0.5 m tall boxes centered on the wall lines.
         Each is its own static model so it can be moved or deleted easily. -->

    <!-- North wall (room + north end of the long hall branch) -->
    <model name="outer_north">
      <static>true</static>
      <pose>2.2860 6.0960 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.6720 0.1000 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.6720 0.1000 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- South wall of the short hall branch -->
    <model name="outer_south">
      <static>true</static>
      <pose>2.2860 0.0000 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.6720 0.1000 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.6720 0.1000 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- West wall (room + west end of the short hall branch) -->
    <model name="outer_west">
      <static>true</static>
      <pose>0.0000 3.0480 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1000 6.1960 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1000 6.1960 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- East wall, south of the exterior doorway -->
    <model name="outer_east_south">
      <static>true</static>
      <pose>4.5720 1.5240 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1000 3.1480 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1000 3.1480 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- East wall, north of the exterior doorway -->
    <model name="outer_east_north">
      <static>true</static>
      <pose>4.5720 5.3340 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1000 1.6240 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1000 1.6240 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Room south wall (separates room from short hall) -->
    <model name="room_south">
      <static>true</static>
      <pose>1.5240 1.5240 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.1480 0.1000 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.1480 0.1000 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Room east wall, south of the room doorway -->
    <model name="room_east_south">
      <static>true</static>
      <pose>3.0480 2.2860 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1000 1.6240 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1000 1.6240 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Room east wall, north of the room doorway -->
    <model name="room_east_north">
      <static>true</static>
      <pose>3.0480 5.3340 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1000 1.6240 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1000 1.6240 0.50</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
